generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String
  password        String
  first_name      String
  last_name       String
  full_name       String
  avatar          String?
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  organisation_id Int

  // relation
  token         Token?
  message       UserGreetingMessage?
  organisation  Organisation         @relation(fields: [organisation_id], references: [id])
  user_info     UserOrganisation?
  user_statuses UserStatuses?
  groups        UserGroups[]

  @@map(name: "users")
}

model EmailOTP {
  id           Int      @id @default(autoincrement())
  email        String
  created_at   DateTime @default(now())
  is_validated Boolean  @default(false)
  otp          String

  @@map(name: "email_otps")
}

model UserOrganisation {
  id               Int     @id @default(autoincrement())
  organisation_id  Int
  user_id          Int     @unique
  role             Role    @default(guest)
  role_description String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map(name: "user_organisations")
}

model UserStatuses {
  id      Int        @id @default(autoincrement())
  user_id Int        @unique
  status  UserStatus @default(pending)
  closed  Boolean    @default(false)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map(name: "user_statuses")
}

model UserGreetingMessage {
  id      Int    @id @default(autoincrement())
  user_id Int    @unique
  text    String

  // relation
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map(name: "users_greeting_messages")
}

model Organisation {
  id                  Int       @id @default(autoincrement())
  name                String
  short_name          String
  description         String?
  plan_id             Int
  active              Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime? @updatedAt
  registration_active Boolean   @default(true)
  greeting_text       String?

  users User[]
  links RegisterLink[]

  // relation
  plan SubscriptionPlan @relation(fields: [plan_id], references: [id])

  @@map(name: "organisations")
}

model SubscriptionPlan {
  id          Int    @id @default(autoincrement())
  price       Float
  max_student Int    @default(100)
  max_admin   Int    @default(100)
  max_watcher Int    @default(100)
  name        String

  organisations Organisation[]

  @@map(name: "subscription_plans")
}

model RegisterLink {
  id              Int          @id @default(autoincrement())
  role            RegisterRole @default(guest)
  link_code       String
  organisation_id Int

  // relation
  organisation Organisation @relation(fields: [organisation_id], references: [id])

  @@map(name: "register_links")
}

model Token {
  id      Int    @id @default(autoincrement())
  token   String
  user_id Int    @unique

  // relation
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map(name: "tokens")
}

model Group {
  id              Int          @id @default(autoincrement())
  name            String
  organisation_id Int
  created_at      DateTime     @default(now())
  updated_at      DateTime?    @updatedAt
  type            GroupType    @default(student)
  users           UserGroups[]

  // relation
  @@map(name: "groups")
}

model UserGroups {
  id         Int       @id @default(autoincrement())
  user_id    Int
  group_id   Int
  role       GroupRole
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  // relation
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@map(name: "user_groups")
}

enum Role {
  guest
  owner
  admin
  student
  watcher
}

enum GroupRole {
  admin
  member
  moderator
}

enum GroupType {
  student
  mixed
  watcher
  admin
}

enum UserStatus {
  pending
  active
  rejected
}

enum RegisterRole {
  guest
  admin
  student
  watcher
}
